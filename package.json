{
  "name": "@atoapayments/atoa-react-native-sdk",
  "version": "1.0.0",
  "description": "Atoa React Native SDK for integrating Atoa Payments into mobile applications",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "del-cli lib",
    "prepare": "bob build",
    "release": "release-it"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "atoa",
    "payments",
    "open-banking",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ATOAPaymentsLimited/AtoaReactNativeSDK"
  },
  "author": "Atoa Payments Limited <hello@paywithatoa.co.uk>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ATOAPaymentsLimited/AtoaReactNativeSDK/issues"
  },
  "homepage": "https://github.com/ATOAPaymentsLimited/AtoaReactNativeSDK#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "react-native-root-siblings": "^5.0.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@react-native/eslint-config": "^0.76.0",
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.72.0",
    "del-cli": "^5.1.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.0",
    "react": "^18.2.0",
    "react-native": "^0.76.0",
    "react-native-builder-bob": "^0.30.0",
    "react-native-gesture-handler": "^2.20.0",
    "react-native-reanimated": "^3.16.0",
    "react-native-svg": "^15.8.0",
    "lottie-react-native": "^7.1.0",
    "@gorhom/bottom-sheet": "^5.0.0",
    "@react-native-community/netinfo": "^11.4.0",
    "@types/uuid": "^9.0.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.70.0",
    "react-native-svg": ">=13.0.0",
    "lottie-react-native": ">=6.0.0",
    "react-native-reanimated": ">=3.0.0",
    "react-native-gesture-handler": ">=2.0.0",
    "@gorhom/bottom-sheet": ">=4.0.0",
    "@react-native-community/netinfo": ">=9.0.0"
  },
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
